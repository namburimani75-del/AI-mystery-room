# Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mystery-room?retryWrites=true&w=majority

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model for high throughput & quota availability
GEMINI_MODEL=gemini-2.5-flash-lite

# Allowed frontend origin(s) for CORS (comma-separated if multiple, e.g. https://ai-mystery-room-6vfevgnss-ruthless9.vercel.app,https://ai-mystery-room-rose.vercel.app)
CLIENT_URL=https://ai-mystery-room-6vfevgnss-ruthless9.vercel.app,https://ai-mystery-room-rose.vercel.app
