# Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mystery-room?retryWrites=true&w=majority

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model for high throughput & quota availability
GEMINI_MODEL=gemini-2.5-flash-lite

# Allowed frontend origin(s) for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app,http://localhost:5173)
CLIENT_URL=https://your-frontend-domain.vercel.app
