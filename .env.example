# =====================================================================
# AI Mystery Room - Environment Configuration Reference
# =====================================================================

# ---------------------------------------------------------------------
# Backend Variables (Configure in Render Dashboard for server service)
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mystery-room?retryWrites=true&w=majority
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash-lite
CLIENT_URL=https://your-frontend-domain.vercel.app

# ---------------------------------------------------------------------
# Frontend Variables (Configure in Vercel Dashboard for client project)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=https://your-render-backend-domain.onrender.com
